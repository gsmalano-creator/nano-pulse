{
	"name": "nano-pulse",
	"description": "NanoPulse - heartbeat / dead man's switch API on Cloudflare Workers + D1",
	"devDependencies": {
		"typescript": "5.9.3",
		"wrangler": "4.127.0"
	},
	"private": true,
	"scripts": {
		"cf-typegen": "wrangler types",
		"check": "tsc && wrangler deploy --dry-run",
		"dev": "npm run db:migrate:local && npm run db:seed:local && wrangler dev",
		"deploy": "wrangler deploy",
		"predeploy": "wrangler d1 migrations apply DB --remote",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:seed:local": "wrangler d1 execute DB --local --file=./seeds/test-data.sql",
		"db:seed:remote": "wrangler d1 execute DB --remote --file=./seeds/test-data.sql",
		"smoke": "./scripts/smoke.sh"
	},
	"dependencies": {
		"hono": "^4.13.8"
	}
}
